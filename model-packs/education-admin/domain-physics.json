{
  "id": "domain/eduadm/v1",
  "version": "0.1.0",
  "domain_authority": {
    "name": "Education Admin Domain",
    "description": "Domain-level physics for school administration, classroom governance, staff workflows, roster coordination, escalations, and cross-pack module assignment. Student Commons and Guardian runtime state remain owned by education-commons; learning modules remain owned by their subject packs."
  },
  "meta_authority_id": "domain/eduf/foundation-core/v1",
  "actor_schemas": {
    "domain_authority": {
      "domain_state": ["preferences", "management_state"],
      "capabilities": [
        "manage_teachers",
        "manage_modules",
        "view_all_progress",
        "modify_standing_orders",
        "test_as_role"
      ]
    },
    "teacher": {
      "domain_state": [
        "preferences",
        "assigned_students",
        "assigned_rooms",
        "escalation_preferences",
        "active_standing_order_overrides"
      ],
      "capabilities": [
        "view_student_progress",
        "manage_escalations",
        "assign_module",
        "update_user_preferences"
      ]
    },
    "teaching_assistant": {
      "domain_state": ["preferences", "assigned_students", "supervising_teacher_id"],
      "capabilities": ["view_student_progress", "provide_hints"]
    }
  },
  "user_commands": {
    "domain_authority": ["manage_teachers", "manage_modules", "view_all_progress", "modify_standing_orders"],
    "teacher": ["view_student_progress", "manage_escalations", "assign_module"],
    "teaching_assistant": ["view_student_progress"]
  },
  "domain_invariants": [
    {
      "id": "role_boundary",
      "description": "Actors may only access administrative data and operations within their declared capabilities.",
      "severity": "critical"
    },
    {
      "id": "cross_pack_ownership_boundary",
      "description": "Education Admin may coordinate assignments across Commons and subject packs, but must not own guardian runtime state, student commons state, or subject learning generators.",
      "severity": "critical"
    },
    {
      "id": "admin_audit_trail",
      "description": "Roster, assignment, escalation, and staff-governance actions must produce auditable commitment or log records.",
      "severity": "critical"
    }
  ],
  "domain_standing_orders": [
    {
      "id": "preserve_pack_ownership",
      "description": "Route Commons, Guardian, and subject-learning operations to their owning packs instead of duplicating ownership inside Education Admin.",
      "auto_execute": true
    },
    {
      "id": "audit_admin_changes",
      "description": "Record administrative changes with actor, target, role, operation, timestamp, and affected module IDs.",
      "auto_execute": true
    }
  ],
  "domain_roles": {
    "schema_version": "1.0",
    "roles": [
      {
        "role_id": "domain_authority",
        "role_name": "Domain Authority",
        "hierarchy_level": 0,
        "description": "Domain-level administrator with full oversight of education administration, teacher roster, module assignments, standing-order proposals, and escalation queues.",
        "maps_to_system_role": "admin",
        "default_access": "rwx",
        "may_assign_domain_roles": true,
        "max_assignable_level": 2,
        "scoped_capabilities": {
          "receive_escalations": true,
          "modify_standing_orders": true,
          "view_all_student_progress": true,
          "manage_teachers": true,
          "assign_modules": true
        }
      },
      {
        "role_id": "teacher",
        "role_name": "Teacher",
        "hierarchy_level": 1,
        "description": "Certified instructors who manage rosters, assign learning modules, monitor student progress, and receive escalation packets.",
        "maps_to_system_role": "user",
        "default_access": "rwx",
        "may_assign_domain_roles": true,
        "max_assignable_level": 2,
        "scoped_capabilities": {
          "receive_escalations": true,
          "modify_standing_orders": false,
          "view_all_student_progress": true,
          "assign_modules": true
        }
      },
      {
        "role_id": "teaching_assistant",
        "role_name": "Teaching Assistant / Paraprofessional",
        "hierarchy_level": 2,
        "description": "Support staff who help assigned students with guided practice and progress review without modifying domain physics.",
        "maps_to_system_role": "user",
        "default_access": "rx",
        "may_assign_domain_roles": false,
        "scoped_capabilities": {
          "receive_escalations": false,
          "view_student_progress": true,
          "issue_hints": true,
          "view_log_records": true,
          "modify_domain_physics": false
        }
      }
    ],
    "role_acl": [
      {
        "domain_role": "teaching_assistant",
        "access": "rx",
        "scope": "session_monitoring"
      },
      {
        "domain_role": "teaching_assistant",
        "access": "r",
        "scope": "log_records_own_students"
      }
    ]
  },
  "groups": {
    "education_admin_staff": {
      "description": "Teaching and administrative staff with education administration responsibilities.",
      "members": {
        "domain_roles": ["domain_authority", "teacher", "teaching_assistant"]
      }
    }
  }
}
